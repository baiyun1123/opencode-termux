+// C assertions embed __FILE__ even after debug sections are stripped.
+// Map the native checkout root only for the Android build environment.
+fn androidReproducibleCFlags(b: *std.Build, flags: []const []const u8) []const []const u8 {
+    if (b.graph.environ_map.get("BIONIC_SYSROOT_INC") == null) return flags;
+    return appendCFlags(b, flags, &.{b.fmt("-ffile-prefix-map={s}=.", .{b.pathFromRoot("")})});
+}
